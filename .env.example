# Copy to .env and fill in. Never commit .env.
# All settings are read by relay/config.py.

# Anthropic API key. Required in production; RP and quick-chat turns fail without it.
ANTHROPIC_API_KEY=

# HS256 signing key for account and session JWTs. Use at least 32 random bytes,
# e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
# Required in staging/production; development falls back to an insecure fixed key.
INKGLASS_JWT_SECRET=

# Shared secret for the admin interface (port 8081). Required in production.
ADMIN_SECRET=

# Database connection. SQLite for Phase 0-1.
DATABASE_URL=sqlite+aiosqlite:///./inkglass.db

# Gives EVERY caller DM-level write access (protected character fields, scene
# state) and exposes /docs. Local tooling only; keep false whenever players connect.
ADMIN_MODE=false

# Player ids (comma-separated) allowed to open a multiplayer session as DM.
# A DM can grant currency, set protected character fields, edit scene state and
# resolve combat with free-form numbers, so list only people you trust with that.
# Empty = nobody can be DM.
INKGLASS_DM_PLAYER_IDS=

# development | staging | production
ENVIRONMENT=development

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Model that writes NPC replies. Default: claude-sonnet-4-6.
# The RP analysis call forces a tool call, which Claude Sonnet 5.5, Opus 5.5 and
# the Fable models reject, so those cannot be used for analysis until that call
# is rewritten. Changing the reply model changes NPC voice: playtest it.
# INKGLASS_MODEL=claude-sonnet-4-6

# Model for the RP analysis call (checks, scene changes). Empty = same as INKGLASS_MODEL.
# INKGLASS_ANALYSIS_MODEL=

# true = the analysis call does not draft the reply, so the reply is written once
# and starts appearing sooner. Off by default: compare both in the RP Tester and
# keep whichever reads better. Each turn's token counts appear in the relay log
# as "LLM usage".
INKGLASS_RP_FAST_ANALYSIS=false
